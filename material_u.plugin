"""
Material U — Pixel clean UI for exteraGram.

A thin "switcher" plugin: it does NOT hand-draw a new UI (that would be brittle and
break on every app update). Instead it flips exteraGram's own appearance flags toward a
Material-You look (M3 on; liquid glass / blur / glare off) and ships a diagnostic that
dumps the real config keys AND field types of THIS installed version.

Keys below were confirmed from a real device dump (exteraGram v12+). Writes are
TYPE-SAFE: the field's declared Java type is read via reflection first, so we never
store a boolean into an int key (which would crash the app on read).
"""

from base_plugin import BasePlugin  # type: ignore
from hook_utils import find_class, get_static_private_field, set_static_private_field  # type: ignore
from android_utils import run_on_ui_thread, log  # type: ignore
from client_utils import get_last_fragment  # type: ignore
from ui.alert import AlertDialogBuilder  # type: ignore
from ui.settings import Header, Switch, Text, Divider  # type: ignore
from typing import Any, List

__id__ = "material_u"
__name__ = "Material U — Pixel clean UI"
__description__ = (
    "Material You (M3) увімкнено, liquid glass / блюр / відблиски вимкнено. "
    "Містить діагностику з реальними ключами й типами полів твоєї версії."
)
__author__ = "Danylo"
__version__ = "1.1.0"
__icon__ = "exteraPlugins/1"
__min_version__ = "11.0.0"
__app_version__ = ">=11.0.0"
__sdk_version__ = ">=1.0.0"

EXTERA_CONFIG = "com.exteragram.messenger.ExteraConfig"

PRIMITIVES = {"boolean", "int", "long", "float", "double"}

# Material-You preset, keyed by REAL field names from the device dump.
# Value is the desired state; it is coerced to the field's actual type at write time.
PRESET = [
    ("md3Styles", True),         # master Material 3 styles
    ("forceBlur", False),        # liquid glass blur off
    ("blurActionBar", False),
    ("blurBottomPanel", False),
    ("blurDialogs", False),
    ("glassMessageMenu", False), # liquid glass message menu off
    ("glareOnElements", False),  # glass glare off
    ("forceSnow", False),        # seasonal snow off
]


class MaterialUPlugin(BasePlugin):

    # ------------------------------------------------------------------ config
    def _cls(self):
        c = find_class(EXTERA_CONFIG)
        if c is None:
            self.logger.error("ExteraConfig not found — wrong app/version?")
        return c

    def _prefs(self):
        c = self._cls()
        if c is None:
            return None
        try:
            return get_static_private_field(c, "preferences")
        except Exception as e:  # noqa: BLE001
            self.logger.exception(f"reading preferences failed: {e}")
            return None

    def _field_type(self, name: str):
        """Declared Java type of an ExteraConfig field, or None if absent here."""
        c = self._cls()
        if c is None:
            return None
        try:
            return str(c.getDeclaredField(name).getType().getName())
        except Exception:  # noqa: BLE001
            return None

    def _get_static(self, name: str, default=None):
        c = self._cls()
        if c is None:
            return default
        try:
            return get_static_private_field(c, name)
        except Exception:  # noqa: BLE001
            return default

    def _get_bool(self, name: str, default: bool = False) -> bool:
        val = self._get_static(name, None)
        if isinstance(val, bool):
            return val
        if isinstance(val, (int, float)):
            return val != 0
        return default

    def _set_flag(self, name: str, value) -> str:
        """Type-safe write: pref + live static field. Returns ok / skip / error."""
        c = self._cls()
        prefs = self._prefs()
        if c is None or prefs is None:
            return "error"
        ftype = self._field_type(name)
        if ftype not in PRIMITIVES:
            # field does not exist on this version — skip safely, never guess a type
            return "skip"
        try:
            editor = prefs.edit()
            if ftype == "boolean":
                conv = bool(value)
                editor.putBoolean(name, conv)
            elif ftype == "int":
                conv = int(value)
                editor.putInt(name, conv)
            elif ftype == "long":
                conv = int(value)
                editor.putLong(name, conv)
            else:  # float / double
                conv = float(value)
                editor.putFloat(name, conv)
            editor.apply()
        except Exception as e:  # noqa: BLE001
            self.logger.exception(f"put '{name}' failed: {e}")
            return "error"
        try:
            set_static_private_field(c, name, conv)
        except Exception as e:  # noqa: BLE001
            self.logger.warning(f"static '{name}' not live-updated: {e}")
        return "ok"

    def _refresh_ui(self) -> None:
        try:
            from client_utils import get_notification_center  # type: ignore
            nc = find_class("org.telegram.messenger.NotificationCenter")
            get_notification_center().postNotificationName(
                get_static_private_field(nc, "mainUserInfoChanged"), []
            )
        except Exception as e:  # noqa: BLE001
            self.logger.debug(f"refresh skipped: {e}")

    # --------------------------------------------------------------- lifecycle
    def on_plugin_load(self):
        try:
            prefs = self._prefs()
            n = len(prefs.getAll()) if prefs is not None else 0
            self.logger.info(f"Material U loaded; {n} exteraGram keys present")
        except Exception as e:  # noqa: BLE001
            self.logger.exception(f"load dump failed: {e}")

    # ----------------------------------------------------------------- actions
    def _apply_preset(self, *_):
        applied, skipped = [], []
        for name, want in PRESET:
            res = self._set_flag(name, want)
            if res == "ok":
                applied.append(f"{name} -> {want}")
            elif res == "skip":
                skipped.append(name)
        self._refresh_ui()
        msg = ""
        if applied:
            msg += "Застосовано:\n• " + "\n• ".join(applied) + "\n\n"
        if skipped:
            msg += "Немає у цій версії (пропущено): " + ", ".join(skipped) + "\n\n"
        msg += "⚠️ Повністю перезапусти exteraGram (змах із недавніх), щоб побачити зміни блюру/M3."
        self._show_dialog("Material U", msg)

    def _toggle_sections_flat(self, flat: bool):
        # Material "islands" rounding lives in sectionRadius (float). 0 = flat corners.
        self._set_flag("sectionRadius", 0.0 if flat else 17.0)
        self._refresh_ui()

    def _changer(self, name: str):
        def _cb(new_value: bool):
            self._set_flag(name, bool(new_value))
            self._refresh_ui()
        return _cb

    # -------------------------------------------------------------- diagnostics
    def _show_keys(self, *_):
        prefs = self._prefs()
        if prefs is None:
            self._show_dialog("Material U", "Не вдалося прочитати налаштування.")
            return
        rows = []
        try:
            for e in prefs.getAll().entrySet().toArray():
                v = e.getValue()
                sv = repr(v)
                if len(sv) > 80:
                    sv = sv[:77] + "…"
                rows.append(f"{e.getKey()} = {sv}")
        except Exception as ex:  # noqa: BLE001
            self.logger.exception(f"getAll failed: {ex}")
        rows.sort(key=str.lower)
        self._show_dialog(f"Ключі ({len(rows)})", "\n".join(rows))

    def _show_fields(self, *_):
        """Definitive list: every primitive ExteraConfig field as name: type = value."""
        c = self._cls()
        if c is None:
            self._show_dialog("Material U", "ExteraConfig не знайдено.")
            return
        rows = []
        try:
            for f in c.getDeclaredFields():
                tp = str(f.getType().getName())
                if tp not in PRIMITIVES:
                    continue
                name = str(f.getName())
                rows.append(f"{name}: {tp} = {self._get_static(name, '?')}")
        except Exception as ex:  # noqa: BLE001
            self.logger.exception(f"fields dump failed: {ex}")
        rows.sort(key=str.lower)
        self._show_dialog(f"Поля ExteraConfig ({len(rows)})", "\n".join(rows))

    def _copy_keys(self, *_):
        prefs = self._prefs()
        if prefs is None:
            return
        try:
            text = "\n".join(
                f"{e.getKey()} = {e.getValue()!r}"
                for e in prefs.getAll().entrySet().toArray()
            )
            from android_utils import copy_to_clipboard  # type: ignore
            copy_to_clipboard(text)
        except Exception as ex:  # noqa: BLE001
            self.logger.exception(f"copy failed: {ex}")

    def _show_dialog(self, title: str, message: str):
        def _show():
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if not activity:
                log("Material U: no activity for dialog")
                return
            b = AlertDialogBuilder(activity)
            b.set_title(title)
            b.set_message(message or "—")
            b.set_positive_button("OK", lambda d, w: d.dismiss())
            b.show()
        run_on_ui_thread(_show)

    # ---------------------------------------------------------------- settings
    def create_settings(self) -> List[Any]:
        return [
            Header(text="Material You"),
            Text(text="✨ Застосувати пресет Material You", icon="msg_theme",
                 on_click=self._apply_preset),
            Divider(text="M3 увімк., скло/блюр/сніг вимк. Потрібен повний перезапуск exteraGram."),

            Header(text="Material 3"),
            Switch(key="mu_md3Styles", text="Material 3 стиль (M3)",
                   default=self._get_bool("md3Styles", False), icon="msg_colors",
                   on_change=self._changer("md3Styles")),
            Switch(key="mu_sectionsFlat", text="Пласкі секції (без острівців)",
                   default=(self._get_static("sectionRadius", 17.0) == 0),
                   icon="msg_list", on_change=self._toggle_sections_flat),

            Header(text="Прибрати liquid glass / блюр"),
            Switch(key="mu_forceBlur", text="Примусовий блюр",
                   default=self._get_bool("forceBlur", False), icon="msg_photo_settings",
                   on_change=self._changer("forceBlur")),
            Switch(key="mu_glassMessageMenu", text="Скляне меню повідомлень",
                   default=self._get_bool("glassMessageMenu", False), icon="msg_message",
                   on_change=self._changer("glassMessageMenu")),
            Switch(key="mu_glareOnElements", text="Відблиски на елементах",
                   default=self._get_bool("glareOnElements", False), icon="msg_bulb",
                   on_change=self._changer("glareOnElements")),

            Header(text="Інше"),
            Switch(key="mu_forceSnow", text="Сніг",
                   default=self._get_bool("forceSnow", False), icon="msg_photo_settings",
                   on_change=self._changer("forceSnow")),
            Switch(key="mu_squareFab", text="Квадратна кнопка (FAB)",
                   default=self._get_bool("squareFab", True), icon="msg_edit",
                   on_change=self._changer("squareFab")),
            Divider(),

            Header(text="Діагностика"),
            Text(text="🧬 Поля ExteraConfig (назва: тип = значення)", icon="msg_info",
                 on_click=self._show_fields),
            Text(text="🔍 Усі збережені ключі", icon="msg_settings",
                 on_click=self._show_keys),
            Text(text="📋 Скопіювати ключі в буфер", icon="msg_copy",
                 on_click=self._copy_keys),
            Divider(text="Надішли «Поля ExteraConfig», щоб доточити острівці/вкладки точно."),
        ]
