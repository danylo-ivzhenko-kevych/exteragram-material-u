"""
Material U — Pixel clean UI for exteraGram.

A thin "switcher" plugin: it does NOT hand-draw a new UI (too brittle). It flips
exteraGram's own appearance flags toward a Material-You look (M3 on; liquid glass /
blur / glare off) and ships diagnostics that read the real config of THIS device.

v1.3.0
  * Reliable feedback: results go to a Bulletin toast AND the clipboard (both proven
    to work). The AlertDialog is best-effort only and can never break a button.
  * Writes are SELF-VERIFYING: commit() then read the value back; the self-test report
    shows `type / wrote / commit / now` per key so persistence is visible on-device.
  * Settings switches are synced to the LIVE exteraGram config on open, so they show
    the real state (not the plugin's own stored mirror).
  * Type-safe writes: field type resolved from reflection, then the stored value's
    class, then a known map — never store the wrong type into a key.
"""

from base_plugin import BasePlugin  # type: ignore
from hook_utils import find_class, get_static_private_field, set_static_private_field  # type: ignore
from android_utils import run_on_ui_thread, log  # type: ignore
from client_utils import get_last_fragment  # type: ignore
from ui.settings import Header, Switch, Text, Divider  # type: ignore
from typing import Any, List

__id__ = "material_u"
__name__ = "Material U — Pixel clean UI"
__description__ = (
    "Material You (M3) увімк., liquid glass / блюр / відблиски вимк. Самотест запису "
    "показує, чи зміни реально зберігаються (результат у буфері + тост)."
)
__author__ = "Danylo"
__version__ = "1.4.0"
__icon__ = "exteraPlugins/1"
__min_version__ = "11.0.0"
__app_version__ = ">=11.0.0"
__sdk_version__ = ">=1.0.0"

EXTERA_CONFIG = "com.exteragram.messenger.ExteraConfig"
PREFS_NAME = "exteraconfig"
PRIMITIVES = {"boolean", "int", "long", "float", "double"}

# Fallback type map (used only if reflection + stored-value typing both fail).
TYPE_MAP = {
    "md3Styles": "boolean", "forceBlur": "boolean", "forceSnow": "boolean",
    "glassMessageMenu": "boolean", "glareOnElements": "boolean",
    "blurActionBar": "boolean", "blurBottomPanel": "boolean",
    "blurDialogs": "boolean", "squareFab": "boolean",
    "glassOutlineStyle": "int", "sectionRadius": "float", "avatarCorners": "float",
}

# Material-You preset, keyed by REAL field names confirmed from a device dump.
PRESET = [
    ("md3Styles", True),
    ("forceBlur", False),
    ("blurActionBar", False),
    ("blurBottomPanel", False),
    ("blurDialogs", False),
    ("glassMessageMenu", False),
    ("glareOnElements", False),
    ("forceSnow", False),
]

# Switches shown in settings: (plugin_key, real_config_key, title, icon, default)
SWITCHES = [
    ("mu_md3Styles", "md3Styles", "Material 3 стиль (M3)", "msg_colors", False),
    ("mu_forceBlur", "forceBlur", "Примусовий блюр", "msg_photo_settings", False),
    ("mu_glassMessageMenu", "glassMessageMenu", "Скляне меню повідомлень", "msg_message", False),
    ("mu_glareOnElements", "glareOnElements", "Відблиски на елементах", "msg_bulb", False),
    ("mu_forceSnow", "forceSnow", "Сніг", "msg_photo_settings", False),
    ("mu_squareFab", "squareFab", "Квадратна кнопка (FAB)", "msg_edit", True),
]


class MaterialUPlugin(BasePlugin):

    # ------------------------------------------------------------------ config
    def _cls(self):
        return find_class(EXTERA_CONFIG)

    def _prefs(self):
        """SharedPreferences('exteraconfig') from the app Context (most reliable)."""
        try:
            al = find_class("org.telegram.messenger.ApplicationLoader")
            ctx = get_static_private_field(al, "applicationContext")
            if ctx is not None:
                return ctx.getSharedPreferences(PREFS_NAME, 0)  # MODE_PRIVATE
        except Exception as e:  # noqa: BLE001
            self.logger.warning(f"context prefs failed, falling back: {e}")
        c = self._cls()
        try:
            return get_static_private_field(c, "preferences") if c else None
        except Exception:  # noqa: BLE001
            return None

    def _stored_type(self, prefs, name):
        try:
            val = prefs.getAll().get(name)
        except Exception:  # noqa: BLE001
            return None
        if val is None:
            return None
        return {
            "java.lang.Boolean": "boolean", "java.lang.Integer": "int",
            "java.lang.Long": "long", "java.lang.Float": "float",
        }.get(str(val.getClass().getName()))

    def _reflect_type(self, name):
        c = self._cls()
        if c is None:
            return None
        try:
            return str(c.getDeclaredField(name).getType().getName())
        except Exception:  # noqa: BLE001
            return None

    def _type_of(self, prefs, name):
        return (self._reflect_type(name)
                or self._stored_type(prefs, name)
                or TYPE_MAP.get(name))

    def _get_static(self, name, default=None):
        c = self._cls()
        if c is None:
            return default
        try:
            return get_static_private_field(c, name)
        except Exception:  # noqa: BLE001
            return default

    def _get_bool(self, name, default=False):
        # prefer the live stored pref, fall back to the static field
        prefs = self._prefs()
        if prefs is not None:
            try:
                if prefs.contains(name):
                    return bool(prefs.getBoolean(name, default))
            except Exception:  # noqa: BLE001
                pass
        val = self._get_static(name, None)
        if isinstance(val, bool):
            return val
        if isinstance(val, (int, float)):
            return val != 0
        return default

    def _set_flag(self, name, value):
        """Type-safe write + commit + read-back. Returns a result dict."""
        prefs = self._prefs()
        if prefs is None:
            return {"name": name, "status": "no-prefs"}
        ftype = self._type_of(prefs, name)
        if ftype not in PRIMITIVES:
            return {"name": name, "status": "skip (no field)"}
        try:
            editor = prefs.edit()
            if ftype == "boolean":
                conv = bool(value); editor.putBoolean(name, conv)
            elif ftype == "int":
                conv = int(value); editor.putInt(name, conv)
            elif ftype == "long":
                conv = int(value); editor.putLong(name, conv)
            else:
                conv = float(value); editor.putFloat(name, conv)
            committed = bool(editor.commit())
        except Exception as e:  # noqa: BLE001
            self.logger.exception(f"put '{name}' failed: {e}")
            return {"name": name, "status": f"error {e}"}
        try:
            if ftype == "boolean":
                now = prefs.getBoolean(name, not conv)
            elif ftype == "int":
                now = prefs.getInt(name, -999999)
            elif ftype == "long":
                now = prefs.getLong(name, -999999)
            else:
                now = prefs.getFloat(name, -999999.0)
        except Exception:  # noqa: BLE001
            now = "?"
        c = self._cls()
        if c is not None:
            try:
                set_static_private_field(c, name, conv)
            except Exception as e:  # noqa: BLE001
                self.logger.warning(f"static '{name}' not updated: {e}")
        return {"name": name, "type": ftype, "wrote": conv, "commit": committed,
                "now": now, "status": "ok" if now == conv else "MISMATCH"}

    def _refresh_ui(self):
        try:
            from client_utils import get_notification_center  # type: ignore
            nc = find_class("org.telegram.messenger.NotificationCenter")
            get_notification_center().postNotificationName(
                get_static_private_field(nc, "mainUserInfoChanged"), [])
        except Exception as e:  # noqa: BLE001
            self.logger.debug(f"refresh skipped: {e}")

    # ----------------------------------------------------------------- feedback
    def _bulletin(self, msg, kind="info"):
        try:
            from ui.bulletin import BulletinHelper  # type: ignore
            f = get_last_fragment()
            if kind == "success":
                BulletinHelper.show_success(msg, f)
            elif kind == "error":
                BulletinHelper.show_error(msg, f)
            else:
                BulletinHelper.show_info(msg, f)
            return True
        except Exception as e:  # noqa: BLE001
            self.logger.debug(f"bulletin failed: {e}")
            return False

    def _copy(self, text):
        try:
            from android_utils import copy_to_clipboard  # type: ignore
            copy_to_clipboard(text)
            return True
        except Exception as e:  # noqa: BLE001
            self.logger.exception(f"clipboard failed: {e}")
            return False

    def _dialog(self, title, message):
        """Best-effort dialog; wrapped so it can never break the caller."""
        def _show():
            try:
                from ui.alert import AlertDialogBuilder  # type: ignore
                f = get_last_fragment()
                act = f.getParentActivity() if f else None
                if not act:
                    return
                b = AlertDialogBuilder(act)
                b.set_title(title)
                b.set_message(message or "—")
                b.set_positive_button("OK", lambda d, w: d.dismiss())
                b.create()
                b.set_cancelable(True)
                b.show()
            except Exception as e:  # noqa: BLE001
                log(f"Material U dialog failed: {e}")
        run_on_ui_thread(_show)

    def _report(self, title, text, summary=None):
        """Show a bulletin summary, copy full text to clipboard, try a dialog."""
        copied = self._copy(text)
        tail = "скопійовано в буфер" if copied else "див. лог"
        self._bulletin(summary or f"{title}: {tail}", "success" if copied else "error")
        self._dialog(title, text)

    # --------------------------------------------------------------- lifecycle
    def on_plugin_load(self):
        try:
            prefs = self._prefs()
            n = len(prefs.getAll()) if prefs is not None else 0
            self.logger.info(f"Material U {__version__}; {n} keys; prefs={prefs}")
        except Exception as e:  # noqa: BLE001
            self.logger.exception(f"load check failed: {e}")

    # ----------------------------------------------------------------- actions
    def _selftest_feedback(self, *_):
        """Minimal: proves the button tap + feedback channels work."""
        self._copy("Material U feedback test — якщо бачиш це, буфер працює.")
        if not self._bulletin("Material U: кнопки працюють ✓", "success"):
            self._dialog("Material U",
                         "Кнопки працюють. Тост недоступний — звіти йтимуть у буфер.")

    def _apply_preset(self, *_):
        try:
            results = [self._set_flag(n, v) for n, v in PRESET]
            self._refresh_ui()
            lines, nok, nbad, nskip = [], 0, 0, 0
            for r in results:
                st = r["status"]
                if st == "ok":
                    nok += 1
                    lines.append(f"✓ {r['name']}: {r['type']} = {r['wrote']}")
                elif st == "MISMATCH":
                    nbad += 1
                    lines.append(f"✗ {r['name']}: записав {r['wrote']}, читається {r['now']} "
                                 f"(commit={r['commit']})")
                else:
                    nskip += 1
                    lines.append(f"• {r['name']}: {st}")
            text = (f"Material U {__version__} — самотест запису\n"
                    f"✓збережено={nok}  ✗не збереглось={nbad}  •пропущено={nskip}\n\n"
                    + "\n".join(lines) +
                    "\n\nЯкщо всюди ✓ — повністю перезапусти exteraGram, щоб побачити UI.\n"
                    "Якщо є ✗/• — надішли цей текст.")
            self._report("Самотест", text,
                         summary=f"Самотест: ✓{nok} ✗{nbad} •{nskip} — у буфері")
        except Exception as e:  # noqa: BLE001
            self.logger.exception(f"preset failed: {e}")
            self._copy(f"Material U preset error: {e}")
            self._bulletin(f"Помилка пресету: {e}", "error")

    def _toggle_sections_flat(self, flat):
        r = self._set_flag("sectionRadius", 0.0 if flat else 17.0)
        self._refresh_ui()
        self._bulletin(f"Секції: {r.get('status', '?')} (перезапусти застосунок)",
                       "success" if r.get("status") == "ok" else "error")

    def _changer(self, name):
        def _cb(new_value):
            r = self._set_flag(name, bool(new_value))
            self._refresh_ui()
            self._bulletin(f"{name} = {r.get('now', '?')} ({r.get('status', '?')})",
                           "success" if r.get("status") == "ok" else "error")
        return _cb

    # -------------------------------------------------------------- diagnostics
    def _show_fields(self, *_):
        c = self._cls()
        if c is None:
            self._report("Поля", "ExteraConfig не знайдено.")
            return
        rows, err = [], None
        try:
            for f in c.getDeclaredFields():
                tp = str(f.getType().getName())
                if tp not in PRIMITIVES:
                    continue
                nm = str(f.getName())
                rows.append(f"{nm}: {tp} = {self._get_static(nm, '?')}")
        except Exception as ex:  # noqa: BLE001
            err = str(ex)
            self.logger.exception(f"fields dump failed: {ex}")
        rows.sort(key=str.lower)
        body = "\n".join(rows) if rows else f"(порожньо) помилка рефлексії: {err}"
        self._report(f"Поля ExteraConfig ({len(rows)})", body)

    def _show_keys(self, *_):
        prefs = self._prefs()
        if prefs is None:
            self._report("Ключі", "Не вдалося прочитати налаштування.")
            return
        rows = []
        try:
            for e in prefs.getAll().entrySet().toArray():
                sv = repr(e.getValue())
                if len(sv) > 70:
                    sv = sv[:67] + "…"
                rows.append(f"{e.getKey()} = {sv}")
        except Exception as ex:  # noqa: BLE001
            self.logger.exception(f"getAll failed: {ex}")
        rows.sort(key=str.lower)
        self._report(f"Ключі ({len(rows)})", "\n".join(rows))

    # ---------------------------------------------------------------- settings
    def create_settings(self) -> List[Any]:
        items: List[Any] = [
            Header(text="Material You"),
            Text(text="🔔 Перевірити (тост + буфер)", icon="msg_info",
                 on_click=self._selftest_feedback),
            Text(text="✨ Застосувати пресет (самотест)", icon="msg_theme",
                 on_click=self._apply_preset),
            Divider(text="Спершу тисни «Перевірити»: має зʼявитись тост і текст у буфері."),

            Header(text="Material 3 / острівці"),
            Switch(key="mu_md3Styles", text="Material 3 стиль (M3)",
                   default=self._get_bool("md3Styles", False), icon="msg_colors",
                   on_change=self._changer("md3Styles")),
            Switch(key="mu_sectionsFlat", text="Пласкі секції (без острівців)",
                   default=(self._get_static("sectionRadius", 17.0) == 0),
                   icon="msg_list", on_change=self._toggle_sections_flat),

            Header(text="Прибрати liquid glass / блюр"),
        ]
        for pkey, ckey, title, icon, default in SWITCHES:
            if ckey in ("md3Styles", "squareFab", "forceSnow"):
                continue  # placed in their own sections below
            items.append(Switch(key=pkey, text=title,
                                 default=self._get_bool(ckey, default), icon=icon,
                                 on_change=self._changer(ckey)))
        items += [
            Header(text="Інше"),
            Switch(key="mu_forceSnow", text="Сніг",
                   default=self._get_bool("forceSnow", False), icon="msg_photo_settings",
                   on_change=self._changer("forceSnow")),
            Switch(key="mu_squareFab", text="Квадратна кнопка (FAB)",
                   default=self._get_bool("squareFab", True), icon="msg_edit",
                   on_change=self._changer("squareFab")),
            Divider(),

            Header(text="Діагностика"),
            Text(text="🧬 Поля ExteraConfig (назва: тип = значення)", icon="msg_info",
                 on_click=self._show_fields),
            Text(text="🔍 Усі збережені ключі", icon="msg_settings",
                 on_click=self._show_keys),
        ]
        return items
